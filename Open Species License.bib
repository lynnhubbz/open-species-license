@article{planteWelcomeJungleContent2017,
  title = {‘{{Welcome}} to the Jungle’: {{Content}} Creators and Fan Entitlement in the Furry Fandom},
  shorttitle = {‘{{Welcome}} to the Jungle’},
  author = {Plante, Courtney N. and Reysen, Stephen and Roberts, Sharon and Gerbasi, Kathleen},
  date = {2017-03-01},
  journaltitle = {Journal of Fandom Studies, The},
  shortjournal = {J. Fandom Stud.},
  volume = {5},
  number = {1},
  pages = {63--80},
  issn = {2046-6692, 2046-6706},
  doi = {10.1386/jfs.5.1.63_1},
  url = {https://intellectdiscover.com/content/journals/10.1386/jfs.5.1.63_1},
  urldate = {2026-09-27},
  abstract = {Abstract             In the present research, we examined fan entitlement among members of the furry fandom – a group of people with a shared interest in media and activities that feature anthropomorphic animals (animals given human-like features). We surveyed both fans and content creators in the fandom, which allowed us to test several predictors of fan entitlement (e.g., stigmatization, age) and the relationship between fan entitlement and perceptions of fan entitlement among artists. The results are then contextualized within well-known psychological processes (e.g., the availability heuristic), laying the groundwork for future research on the processes underlying fan entitlement and its effects. Implications of the results are discussed for three different bodies of research: research on the furry fandom specifically, research on fan entitlement more broadly, and research on fan/creator relationships in general.},
  langid = {english},
  keywords = {/unread},
  file = {D:\Bibliography\storage\7YI6XEPW\Plante et al. - 2017 - ‘Welcome to the jungle’ Content creators and fan entitlement in the furry fandom.pdf}
}

